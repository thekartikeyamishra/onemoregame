{
  "manifest_version": 3,
  "name": "ONE MORE: 60-Second Arcade",
  "short_name": "ONE MORE",
  "version": "1.0.0",
  "description": "A 60-second skill arcade in your toolbar. Practice offline in one click, then take on the Daily Arena and Battle at onemoregame.me.",
  "homepage_url": "https://onemoregame.me/?utm_source=chrome_ext",
  "action": {
    "default_title": "ONE MORE: play a 60-second run",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "notifications", "storage"],
  "minimum_chrome_version": "110"
}

# ---------- Public (exposed to the browser; never put secrets here) ----------
# Canonical production origin, no trailing slash. Used for canonical URLs, sitemap and email links.
# Production: https://onemoregame.me (the default when unset in a production build). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Real store listing URLs. Leave empty to keep the "Coming soon" state. Only play.google.com / apps.apple.com are accepted.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Real public contact address shown on /contact, /privacy and /terms.
NEXT_PUBLIC_CONTACT_EMAIL=support@onemoregame.me
# Legal owner/operator name as it should appear in the footer and legal pages (person or registered entity).
NEXT_PUBLIC_OPERATOR_NAME=Kartikeya Mishra
# Discord invite shown in the community prompts and after Battle matches. Only discord.gg / discord.com links are accepted.
# Use a non-expiring invite (Discord → Invite People → Edit invite link → Expire after: Never).
NEXT_PUBLIC_DISCORD_INVITE=
# Social channels live in src/lib/socials.ts (edit there; Discord invite links can expire — use a permanent one).
# true = load the AdSense tag on content pages (needed for AdSense review and Auto ads). Never on the game/forms.
# Publisher ID defaults to ca-pub-4557897331416844 when NEXT_PUBLIC_ADSENSE_CLIENT is empty.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
# Numeric ad unit ID for the in-content slot (How to Play and guides). Create it after AdSense approval.
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=
# Optional Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------- Server settings ----------
# THIS FILE IS FOR LOCAL DEVELOPMENT: copy it to .env.local and run `npm run dev`.
# Production values live in Vercel environment variables (+ Secret Manager) — do not copy production settings here.

# Local: leave empty (a dev-only secret is used). Production: 32+ random chars via Secret Manager.
APP_SECRET=
# Local: "memory" (in-process, resets on restart — no Firebase needed).
# Use "firestore" locally only with credentials: `gcloud auth application-default login` + GOOGLE_CLOUD_PROJECT below.
DATA_BACKEND=memory
# Only for local production-mode smoke tests (`npm run build` + `npm start` with memory/console). Never in deployed envs.
ALLOW_INSECURE_DEV_BACKENDS=false
# Local: "console" prints emails (with clickable links) in the terminal. Production: "resend".
MAIL_PROVIDER=console
RESEND_API_KEY=
# Must be a sender on a domain you verified with the provider, e.g. "ONE MORE <hello@yourdomain.com>"
MAIL_FROM=ONE MORE <support@onemoregame.me>
# How many trusted proxies append to X-Forwarded-For in front of the app. Vercel: 1.
TRUSTED_PROXY_HOPS=1
# Optional: receive a notification when a campus organizer submits interest.
OWNER_NOTIFY_EMAIL=
# Optional: ChatGPT app-directory domain verification token (served at /.well-known/openai-apps-challenge).
OPENAI_APPS_CHALLENGE=

# Local Firestore emulator (optional). Locally, credentials come from `gcloud auth application-default login`
# or GOOGLE_APPLICATION_CREDENTIALS pointing to a key file stored OUTSIDE this repository.
# Vercel (or any host without Google workload identity): paste the service-account JSON key, raw or base64.
# FIREBASE_SERVICE_ACCOUNT_KEY=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_CLOUD_PROJECT=onemoregameme

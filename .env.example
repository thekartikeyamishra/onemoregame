# Copy to .env.local for development. In production, set these in Vercel → Project → Settings → Environment Variables.
# Everything is optional except the three marked REQUIRED; features switch on as you fill them in.

# ---------- Site ----------
# Must match the PRIMARY domain in Vercel → Settings → Domains (currently www).
NEXT_PUBLIC_SITE_URL=https://www.kartikeyamishra.info
NEXT_PUBLIC_CONTACT_EMAIL=workmailkartikeya@gmail.com
NEXT_PUBLIC_AVAILABILITY=Open to new client projects
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=

# ---------- App store buttons (leave empty = "Coming soon") ----------
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=

# ---------- Security (REQUIRED in production) ----------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HASH_SALT=
APP_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/cleanup
CRON_SECRET=

# ---------- Firebase / Firestore (REQUIRED for sign-ups and project forms) ----------
# Option A: base64 of the service-account JSON (PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json")) )
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option B: individual fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Email via Resend (enables double opt-in + inquiry notifications) ----------
RESEND_API_KEY=
EMAIL_FROM="Kartikeya Mishra <hello@kartikeyamishra.info>"
INQUIRY_NOTIFY_EMAIL=

# ---------- Shared rate limits & cache via Upstash Redis (strongly recommended) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Mitra AI fallback (optional; without it Mitra uses free scripted answers only) ----------
AI_CHAT=on
AI_PROVIDER=anthropic          # anthropic | openai (any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=claude-haiku-5-5      # cheap, fast default
AI_BASE_URL=                   # only for openai-compatible providers
AI_DAILY_CAP=300               # hard ceiling on model calls per day, site-wide

# ---------- Search engines ----------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------- Google AdSense ----------
# Already configured in lib/site.ts (publisher ca-pub-4557897331416844 and your three ad units).
# Only set these to override, or set a value to "off" to switch a unit (or all ads) off.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4557897331416844
# NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=2364694405
# NEXT_PUBLIC_ADSENSE_SLOT_END_ARTICLE=1212676091
# NEXT_PUBLIC_ADSENSE_SLOT_TOOL=8546959374

# Extra disposable-email domains to block, comma separated
DISPOSABLE_DOMAINS=
